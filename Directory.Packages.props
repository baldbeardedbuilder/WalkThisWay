<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <!-- Extension SDK -->
    <PackageVersion Include="Microsoft.CommandPalette.Extensions" Version="0.9.260204002-experimental" />

    <!-- WinRT & COM Server -->
    <PackageVersion Include="Microsoft.Windows.CsWinRT" Version="2.2.0" />
    <PackageVersion Include="Shmuelie.WinRTServer" Version="2.1.1" />

    <!-- Drawing (HICON to PNG conversion) -->
    <PackageVersion Include="System.Drawing.Common" Version="9.0.6" />

    <!-- JSON -->
    <PackageVersion Include="System.Text.Json" Version="9.0.8" />

    <!-- Testing -->
    <PackageVersion Include="Moq" Version="4.20.72" />
    <PackageVersion Include="MSTest" Version="3.7.0" />

    <!-- Build Tools -->
    <PackageVersion Include="Microsoft.Windows.SDK.BuildTools.MSIX" Version="1.7.20250829.1" />
  </ItemGroup>
</Project>
